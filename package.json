{
  "name": "@open-document-alliance/whiteboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An Excalidraw-powered Whiteboard MCP App for diagrams and visual storytelling in ChatGPT",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:ui": "vite --host 127.0.0.1 --port 3175 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "build": "npm run typecheck && vite build && tsx scripts/build-server.ts",
    "start": "node dist/main.js",
    "check": "npm run test && npm run build",
    "qa:render": "node scripts/qa-render.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@excalidraw/excalidraw": "0.18.1",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "5.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@napi-rs/canvas": "1.0.10",
    "@types/express": "5.0.6",
    "@types/node": "24.19.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "jsdom": "30.1.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "vite-plugin-singlefile": "2.3.3"
  },
  "overrides": {
    "lodash-es": "4.18.1",
    "nanoid@3": "3.3.20"
  }
}
